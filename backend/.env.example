# --- Multi-Account LLM Keys & Provider Configuration ---
# You can provide multiple keys separated by commas:
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default Primary Provider: "gemini" or "ollama"
DEFAULT_AI_PROVIDER=gemini

# --- MySQL Database Configuration ---
# Example MySQL: mysql+pymysql://root:password@localhost:3306/resume_db
# If left as sqlite, uses local database in backend/data/app.db
DATABASE_URL=sqlite:///./data/app.db

# JWT Secret
JWT_SECRET_KEY=change_this_to_a_secure_random_key
